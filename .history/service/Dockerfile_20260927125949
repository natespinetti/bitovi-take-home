FROM golang:1.22 AS builder

WORKDIR /app

COPY go.mod ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux \
    go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /order-processor \
    .

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder \
    --chown=nonroot:nonroot \
    /order-processor \
    /order-processor

USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/order-processor"]